# ─── Database ────────────────────────────────────────────────────────────────
# Local Docker (docker-compose up)
DATABASE_URL=postgresql://reflight:reflight_dev@localhost:5432/reflight
# Render (replace with your Render Internal Database URL)
# DATABASE_URL=postgresql://user:pass@dpg-xxx.render.com/reflight

# Disable SSL for local Postgres; remove or set to "require" for Render
PGSSLMODE=disable

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME
CLERK_SECRET_KEY=sk_test_REPLACE_ME

# ─── API Server ───────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
