# ─── Clerk (must match API server keys) ──────────────────────────────────────
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# ─── API endpoint ─────────────────────────────────────────────────────────────
# Local dev (Expo tunnel or LAN): use your machine's LAN IP or tunnel URL
# e.g. http://192.168.1.x:8080  or  https://abc123.ngrok.io
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Staging/production (Render deploy URL)
# EXPO_PUBLIC_API_BASE_URL=https://reflight-api.onrender.com

# ─── Optional Clerk proxy ─────────────────────────────────────────────────────
# Only needed when API_BASE_URL is set and you want Clerk to proxy through your server
# EXPO_PUBLIC_CLERK_PROXY_URL=https://reflight-api.onrender.com/api/__clerk
